{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/beint-no/saf-t-extended/main/spec/manifest.schema.json",
  "title": "SAF-T Extended 0.4 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "createdAt", "exporter", "sourceSystem", "company", "period", "safT", "objects", "documents", "extras", "missingDocuments"],
  "properties": {
    "format": { "const": "saf-t-extended" },
    "version": { "const": "0.4" },
    "createdAt": { "type": "string", "format": "date-time" },
    "exporter": { "$ref": "#/$defs/exporter" },
    "sourceSystem": { "$ref": "#/$defs/sourceSystem" },
    "company": { "$ref": "#/$defs/company" },
    "period": { "$ref": "#/$defs/period" },
    "safT": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/safTFile" } },
    "objects": { "$ref": "#/$defs/objects" },
    "documents": { "type": "array", "items": { "$ref": "#/$defs/document" } },
    "extras": { "type": "array", "items": { "$ref": "#/$defs/extra" } },
    "missingDocuments": { "type": "array", "items": { "$ref": "#/$defs/missingDocument" } }
  },
  "$defs": {
    "exporter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "software"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "software": { "type": "string", "minLength": 1 }
      }
    },
    "sourceSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] }
      }
    },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "organizationNumber"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "organizationNumber": { "type": "string", "minLength": 1 }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" }
      }
    },
    "safTFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "version"],
      "properties": {
        "path": { "type": "string", "pattern": "^saf-t/[^/]+\\.xml$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "objects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "customers": { "$ref": "#/$defs/objectFile" },
        "suppliers": { "$ref": "#/$defs/objectFile" },
        "employees": { "$ref": "#/$defs/objectFile" },
        "departments": { "$ref": "#/$defs/objectFile" },
        "projects": { "$ref": "#/$defs/objectFile" },
        "products": { "$ref": "#/$defs/objectFile" },
        "orders": { "$ref": "#/$defs/objectFile" }
      }
    },
    "objectFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": { "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "mediaType", "type", "sourceIds", "transactions"],
      "properties": {
        "path": { "type": "string", "pattern": "^documents/" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mediaType": { "type": "string", "minLength": 1 },
        "type": { "enum": ["invoice", "credit-note", "receipt", "attachment", "bank-document", "payroll-document"] },
        "sourceIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "transactions": { "type": "array", "items": { "$ref": "#/$defs/transactionReference" }, "uniqueItems": true }
      }
    },
    "extra": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "mediaType"],
      "properties": {
        "path": { "type": "string", "pattern": "^extras/" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mediaType": { "type": "string", "minLength": 1 }
      }
    },
    "transactionReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safTFile", "journalId", "transactionId", "recordIds"],
      "properties": {
        "safTFile": { "type": "string", "pattern": "^saf-t/[^/]+\\.xml$" },
        "journalId": { "type": "string", "minLength": 1 },
        "transactionId": { "type": "string", "minLength": 1 },
        "recordIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "missingDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "reason"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "reason": { "enum": ["not-found", "not-exportable"] }
      }
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
